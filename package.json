{
	"private": true,
	"scripts": {
		"coverage": "nyc npm -s run test:unit",
		"precommit": "npm -s run lint:frontend && npm -s run coverage && composer test",
		"test:unit": "mw-node-qunit \"tests/node-qunit/**/*.test.js\"",
		"lint": "npm -s run lint:i18n && npm -s run lint:frontend",
		"lint:frontend": "npm -s run lint:js && npm -s run lint:css",
		"lint:js": "eslint --cache .",
		"lint:css": "stylelint --cache \"**/*.less\"",
		"lint:i18n": "banana-checker --requireLowerCase=0 i18n/",
		"minify": "npm -s run minify:svg",
		"minify:svg": "svgo --config=.svgo.config.js --quiet --recursive --folder resources/",
		"test": "npm -s run lint && bash ./dev-scripts/svg_check.sh && npm -s run coverage && npm -s run jsdoc",
		"jsdoc": "jsdoc -c jsdoc.json",
		"doc": "npm run jsdoc && npm run coverage"
	},
	"pre-commit": "precommit",
	"devDependencies": {
		"@wikimedia/mw-node-qunit": "7.11.0",
		"browserslist-config-wikimedia": "0.7.0",
		"eslint-config-wikimedia": "0.32.3",
		"grunt-banana-checker": "0.13.0",
		"jquery": "3.7.1",
		"jsdoc": "4.0.3",
		"jsdoc-wmf-theme": "1.2.0",
		"mediawiki.router": "file:./tests/node-qunit/utils/mediawiki.router.js",
		"mobile.returnToApp": "file:./src/mobile.returnToApp/package",
		"mobile.startup": "file:./src/mobile.startup/package",
		"mustache": "3.0.1",
		"nyc": "15.0.0",
		"oojs": "7.0.1",
		"oojs-ui": "0.48.3",
		"pre-commit": "1.2.2",
		"qunit": "2.24.1",
		"sinon": "12.0.1",
		"stylelint-config-wikimedia": "0.18.0",
		"svgo": "3.2.0"
	}
}
